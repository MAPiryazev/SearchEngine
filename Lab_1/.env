# Пути к данным
CORPUS_RAW_DIR=corpus/raw
CORPUS_EXTRACTED_DIR=corpus/extracted
CORPUS_ANALYSIS_DIR=corpus/analysis

# Источник 1: Русская Википедия
WIKI_DUMP_URL=https://dumps.wikimedia.org/ruwiki/latest/ruwiki-latest-pages-articles.xml.bz2
WIKI_CATEGORY=География
WIKI_MIN_DOCS=50000
WIKI_LANGUAGE=ru

# Источник 2: Русский Stack Overflow
STACKEXCHANGE_SITE=ru.stackoverflow.com
STACKEXCHANGE_DUMP_URL=https://archive.org/download/stackexchange
STACKEXCHANGE_MIN_DOCS=50000
STACKEXCHANGE_LANGUAGE=ru

# Общие настройки
TOTAL_TARGET_DOCS=100000
ENCODING=utf-8
BUFFER_SIZE=65536
