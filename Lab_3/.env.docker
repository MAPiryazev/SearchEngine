# MongoDB настройки
MONGO_INITDB_DATABASE=search_engine
MONGO_DATA_DIR=./docker-volumes/mongodb
MONGO_LOG_DIR=./docker-volumes/logs

# Mongo Express (веб-интерфейс)
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin123

# Приложение
CRAWLER_CONFIG_PATH=./config/crawler_config.yaml
